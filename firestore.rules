rules_version = '2';

/**
 * joshfarr.com billing Firestore rules (dedicated Firebase project).
 * Never point these at dojo-codex / One Piece Dojo.
 *
 * Roles via custom claims:
 *   - admin: full read; writes go through Admin SDK / callables
 *   - client: read only docs for their clientId
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function clientId() {
      return request.auth.token.clientId;
    }

    function isClientMember(cid) {
      return isSignedIn()
        && request.auth.token.role == 'client'
        && clientId() == cid;
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || isClientMember(clientId);
      allow write: if false;
    }

    match /clientUsers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && request.auth.token.role == 'client'
            && resource.data.clientId == clientId());
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && request.auth.token.role == 'client'
            && resource.data.clientId == clientId());
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && request.auth.token.role == 'client'
            && resource.data.clientId == clientId());
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && request.auth.token.role == 'client'
            && resource.data.clientId == clientId());
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && request.auth.token.role == 'client'
            && resource.data.clientId == clientId());
      allow write: if false;
    }

    match /projectIntegrations/{integrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /accessEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /emailEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
