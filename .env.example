# =============================================================================
# joshfarr.com SPA — BILLING Firebase web config (joshfarr-billing, not dojo-codex)
# Copy to `.env` / `.env.local` for local Vite.
# Netlify: Site configuration → Environment variables → same VITE_* keys
#   (required at build time for the SPA bundle).
# Client web config values below are safe for VITE_* / Netlify (not Functions secrets).
# =============================================================================

VITE_FIREBASE_API_KEY=AIzaSyDychDxROUEBaJ5xxDRcoxOP_ifTyZHjRs
VITE_FIREBASE_AUTH_DOMAIN=joshfarr-billing.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=joshfarr-billing
VITE_FIREBASE_STORAGE_BUCKET=joshfarr-billing.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=943287339582
VITE_FIREBASE_APP_ID=1:943287339582:web:ff4734fbc0b53355625f6f

# Stripe TEST publishable key only (Dashboard → Test mode → Developers → API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Local emulators (optional)
# VITE_USE_FIREBASE_EMULATORS=true

# Server-only secrets (STRIPE_SECRET_KEY, RESEND_*, BILLING_*_DRY_RUN, etc.)
# live in Firebase Functions — see functions/.env.example and docs/billing/ENV.md.
# Do not put sk_test_ / whsec_ / Resend keys in Netlify unless you intentionally
# add a Netlify Function later (current design: Firebase Functions only).
