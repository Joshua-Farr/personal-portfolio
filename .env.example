# =============================================================================
# joshfarr.com SPA — BILLING Firebase web config (NEW project, not dojo-codex)
# Copy to `.env` / `.env.local` for local Vite. Set the same keys in Netlify.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR_BILLING_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_BILLING_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_BILLING_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe TEST publishable key only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Local emulators (optional)
# VITE_USE_FIREBASE_EMULATORS=true
