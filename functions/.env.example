# =============================================================================
# joshfarr.com BILLING Firebase project ONLY
# Do NOT copy values from dojo-codex / One Piece Dojo.
# Use Stripe TEST keys only (sk_test_… / pk_test_…).
# =============================================================================

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Public SPA origin for Checkout / Customer Portal return URLs
APP_BASE_URL=http://localhost:5173

# Optional: Stripe Customer Portal configuration (ACH-first)
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME

# Resend (Phase D — transactional email; dry-run until templates reviewed)
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=billing@joshfarr.com
# Default dry-run=true: log + emailEvents only; no HTTP to Resend
BILLING_EMAIL_DRY_RUN=true

# Admin bootstrap (comma-separated emails granted role=admin claims)
ADMIN_EMAIL_ALLOWLIST=joshua.farr2018@gmail.com

# Phase C — outbound HMAC to Codex (same string on Codex; separate Firebase secret stores)
# BILLING_S2S_HMAC_SECRET=REPLACE_WITH_SHARED_TEST_SECRET
# Default dry-run=true: sign + accessEvents only; no HTTP POST to Codex
BILLING_S2S_DRY_RUN=true

# Phase D — payment failure policy overlays (Firestore system/billingPolicy is base)
BILLING_GRACE_PERIOD_DAYS=5
# BILLING_AUTO_SUSPEND=true
# BILLING_AUTO_REACTIVATE=true
